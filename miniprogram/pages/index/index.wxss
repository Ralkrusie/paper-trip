/* 拾途 Paper Trip · 主页面样式 */
.page {
    width: 100%;
    height: 100vh;
    position: relative;
    overflow: hidden;
    background: #0f1f1d;
}

.trip-map {
    width: 100%;
    height: 100%;
}

/* ---------- 地图悬浮按钮 ---------- */
.map-tools {
    position: absolute;
    top: calc(24rpx + env(safe-area-inset-top));
    right: 24rpx;
    z-index: 30;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
}

.tool-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 14rpx 26rpx;
    margin-bottom: 16rpx;
    border-radius: 999rpx;
    background: rgba(248, 250, 238, 0.95);
    color: #1e302c;
    font-size: 26rpx;
    font-weight: 600;
    box-shadow: 0 6rpx 22rpx rgba(8, 24, 20, 0.28);
}

.tool-btn.is-danger {
    background: #b23a22;
    color: #fff;
}

.key-hint {
    position: absolute;
    top: calc(24rpx + env(safe-area-inset-top));
    left: 24rpx;
    z-index: 30;
    padding: 12rpx 22rpx;
    border-radius: 999rpx;
    background: rgba(201, 104, 15, 0.92);
    color: #fffdf6;
    font-size: 24rpx;
    box-shadow: 0 6rpx 22rpx rgba(8, 24, 20, 0.28);
}

.pick-banner {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    z-index: 30;
    padding: 16rpx 32rpx;
    border-radius: 16rpx;
    background: rgba(21, 45, 42, 0.92);
    color: #f8faee;
    font-size: 26rpx;
}

.map-empty {
    position: absolute;
    top: 42%;
    left: 50%;
    transform: translate(-50%, -50%);
    z-index: 20;
    width: 520rpx;
    padding: 32rpx 36rpx;
    border-radius: 20rpx;
    background: rgba(248, 250, 238, 0.96);
    box-shadow: 0 12rpx 40rpx rgba(8, 24, 20, 0.3);
    text-align: center;
}

.map-empty-title {
    font-size: 30rpx;
    font-weight: 700;
    color: #1e302c;
    margin-bottom: 12rpx;
}

.map-empty-sub {
    font-size: 24rpx;
    color: #5e746e;
    line-height: 1.7;
}

/* ---------- 抽屉把手 ---------- */
.sheet-toggle {
    position: absolute;
    right: 24rpx;
    bottom: calc(40rpx + env(safe-area-inset-bottom));
    z-index: 40;
    display: inline-flex;
    align-items: center;
    padding: 18rpx 36rpx;
    border-radius: 999rpx;
    background: rgba(248, 250, 238, 0.96);
    color: #1e302c;
    font-size: 28rpx;
    font-weight: 600;
    box-shadow: 0 8rpx 26rpx rgba(8, 24, 20, 0.32);
}

.sheet-toggle-arrow {
    margin-left: 8rpx;
    font-size: 24rpx;
}

/* ---------- 底部抽屉 ---------- */
.sheet {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 50;
    height: 72vh;
    display: flex;
    flex-direction: column;
    background: #f8faee;
    border-radius: 28rpx 28rpx 0 0;
    box-shadow: 0 -16rpx 48rpx rgba(8, 24, 20, 0.4);
    transform: translateY(108%);
    transition: transform 320ms cubic-bezier(0.22, 1, 0.36, 1);
}

.sheet.is-open {
    transform: none;
}

.sheet-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 20rpx 28rpx 12rpx;
    border-bottom: 2rpx solid rgba(31, 52, 48, 0.12);
}

.sheet-tabs {
    display: flex;
    background: #e9edda;
    border-radius: 14rpx;
    padding: 6rpx;
}

.sheet-tab {
    padding: 12rpx 34rpx;
    border-radius: 10rpx;
    font-size: 28rpx;
    color: #39514c;
}

.sheet-tab.is-active {
    background: #f8faee;
    color: #1e302c;
    font-weight: 700;
    box-shadow: 0 2rpx 8rpx rgba(16, 40, 36, 0.12);
}

.sheet-close {
    padding: 10rpx 6rpx;
    font-size: 26rpx;
    color: #5e746e;
}

.sheet-body {
    flex: 1;
    overflow: hidden;
    padding: 0 28rpx calc(40rpx + env(safe-area-inset-bottom));
    box-sizing: border-box;
}

/* ---------- 天标签 ---------- */
.day-tabs {
    white-space: nowrap;
    padding: 20rpx 0 6rpx;
}

.day-tab {
    display: inline-block;
    padding: 12rpx 28rpx;
    margin-right: 16rpx;
    border-radius: 999rpx;
    background: #e9edda;
    color: #39514c;
    font-size: 26rpx;
}

.day-tab.is-active {
    background: #2e8f80;
    color: #fdfefb;
    font-weight: 600;
}

.day-tab.is-add {
    border: 2rpx dashed rgba(31, 52, 48, 0.3);
    background: transparent;
    color: #5e746e;
}

.day-meta {
    padding: 14rpx 4rpx;
    font-size: 24rpx;
    color: #5e746e;
}

/* ---------- 行程行 ---------- */
.rows {
    padding-bottom: 12rpx;
}

.item-row {
    display: flex;
    align-items: flex-start;
    padding: 22rpx 20rpx;
    margin-bottom: 14rpx;
    border-radius: 16rpx;
    background: #fff;
    border: 2rpx solid rgba(31, 52, 48, 0.1);
    box-shadow: 0 2rpx 10rpx rgba(16, 40, 36, 0.06);
}

.item-row.is-active {
    border-color: #2e8f80;
}

.item-row.is-late {
    border-color: rgba(201, 104, 15, 0.55);
}

.item-row.is-disabled {
    opacity: 0.62;
    background: #f1f3e8;
}

.item-row .badge {
    margin-right: 20rpx;
    margin-top: 4rpx;
}

.badge.is-off {
    background: #b9c4bd;
}

.item-main {
    flex: 1;
    min-width: 0;
}

.item-title {
    font-size: 30rpx;
    font-weight: 600;
    color: #1e302c;
}

.item-chips {
    margin-top: 8rpx;
}

.chip-item {
    display: inline-block;
    padding: 4rpx 16rpx;
    margin: 0 12rpx 8rpx 0;
    border-radius: 8rpx;
    background: #eef1e4;
    color: #39514c;
    font-size: 22rpx;
}

.chip-item.is-fixed {
    background: rgba(46, 143, 128, 0.16);
    color: #1f6e61;
    font-weight: 600;
}

.chip-item.is-est {
    color: #5e746e;
}

.chip-item.is-late {
    background: rgba(201, 104, 15, 0.14);
    color: #9e510a;
}

.item-note {
    margin-top: 8rpx;
    font-size: 24rpx;
    color: #5e746e;
}

.item-actions {
    flex: none;
    margin-left: 16rpx;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
}

.mini-btn {
    padding: 8rpx 18rpx;
    margin-bottom: 10rpx;
    border-radius: 10rpx;
    background: #e9edda;
    color: #39514c;
    font-size: 24rpx;
}

.mini-btn.is-add {
    background: #2e8f80;
    color: #fdfefb;
    font-size: 30rpx;
    padding: 8rpx 22rpx;
}

/* ---------- 通勤行 ---------- */
.leg-row {
    display: flex;
    align-items: center;
    padding: 12rpx 24rpx 20rpx;
}

.leg-bar {
    flex: none;
    width: 6rpx;
    height: 44rpx;
    border-radius: 4rpx;
    margin-right: 18rpx;
}

.leg-text {
    flex: 1;
    font-size: 24rpx;
    color: #5e746e;
    line-height: 1.5;
}

.section-label {
    padding: 20rpx 4rpx 14rpx;
    font-size: 24rpx;
    color: #5e746e;
}

.list-hint {
    padding: 6rpx 4rpx 22rpx;
    text-align: center;
    font-size: 22rpx;
    color: #9aa8a2;
}

.empty {
    padding: 40rpx 20rpx;
    text-align: center;
    font-size: 26rpx;
    color: #5e746e;
    line-height: 1.8;
}

/* ---------- 地点库 ---------- */
.lib-actions {
    display: flex;
    padding: 20rpx 0 8rpx;
}

.lib-actions .btn {
    margin-right: 16rpx;
}

.lib-search {
    margin: 12rpx 0;
}

.lib-chips {
    padding: 12rpx 0 4rpx;
}

.place-row {
    display: flex;
    align-items: center;
    padding: 22rpx 20rpx;
    margin-bottom: 14rpx;
    border-radius: 16rpx;
    background: #fff;
    border: 2rpx solid rgba(31, 52, 48, 0.1);
}

.place-row.is-active {
    border-color: #2e8f80;
}

.cat-dot {
    flex: none;
    width: 20rpx;
    height: 20rpx;
    border-radius: 50%;
    margin-right: 20rpx;
}

.place-main {
    flex: 1;
    min-width: 0;
}

.place-name {
    font-size: 30rpx;
    font-weight: 600;
    color: #1e302c;
}

.place-sub {
    margin-top: 6rpx;
    font-size: 24rpx;
    color: #5e746e;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.place-usage {
    margin-top: 6rpx;
    font-size: 22rpx;
    color: #1f6e61;
}

/* ---------- 设置 ---------- */
.switch-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 16rpx 4rpx;
    font-size: 28rpx;
    color: #1e302c;
}

/* ---------- 弹层 ---------- */
.popup-mask {
    position: fixed;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    z-index: 90;
    background: rgba(10, 24, 21, 0.55);
    display: flex;
    align-items: flex-end;
}

.popup {
    width: 100%;
    box-sizing: border-box;
    background: #f8faee;
    border-radius: 28rpx 28rpx 0 0;
    padding: 32rpx 32rpx calc(40rpx + env(safe-area-inset-bottom));
    max-height: 80vh;
    overflow-y: auto;
}

.popup-title {
    font-size: 30rpx;
    font-weight: 700;
    color: #1e302c;
    margin-bottom: 24rpx;
}

.popup-row {
    padding: 26rpx 24rpx;
    margin-bottom: 14rpx;
    border-radius: 14rpx;
    background: #fff;
    border: 2rpx solid rgba(31, 52, 48, 0.1);
    font-size: 28rpx;
    color: #1e302c;
}

.popup-row.is-new {
    border-style: dashed;
    background: transparent;
    color: #1f6e61;
}

.popup-cancel {
    margin-top: 18rpx;
    padding: 20rpx;
    text-align: center;
    font-size: 28rpx;
    color: #5e746e;
}