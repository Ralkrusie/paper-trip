/* 拾途 Paper Trip · 地点编辑页样式 */
page {
    background: #f4f6ea;
}

.page {
    padding: 24rpx 28rpx calc(60rpx + env(safe-area-inset-bottom));
}

.card {
    background: #f8faee;
    border-radius: 20rpx;
    padding: 28rpx;
    margin-bottom: 24rpx;
    box-shadow: 0 4rpx 16rpx rgba(16, 40, 36, 0.08);
}

.chips {
    padding-top: 4rpx;
}

.coord-row {
    padding-top: 6rpx;
}

.usage {
    margin-top: 10rpx;
    font-size: 22rpx;
    color: #1f6e61;
}

.search-row {
    display: flex;
    align-items: center;
}

.search-input {
    flex: 1;
    margin-right: 16rpx;
}

.sub-list {
    margin-top: 28rpx;
}

.sub-title {
    font-size: 24rpx;
    color: #5e746e;
    margin-bottom: 14rpx;
}

.sub-row {
    padding: 20rpx 22rpx;
    margin-bottom: 12rpx;
    border-radius: 12rpx;
    background: #fff;
    border: 2rpx solid rgba(31, 52, 48, 0.1);
}

.sub-name {
    font-size: 28rpx;
    color: #1e302c;
}

.sub-address {
    margin-top: 4rpx;
    font-size: 22rpx;
    color: #5e746e;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.actions {
    margin-top: 8rpx;
}

.action-row {
    display: flex;
    justify-content: space-between;
    margin-top: 20rpx;
}