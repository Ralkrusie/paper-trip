/* 拾途 Paper Trip · 行程图样式 */
page {
    background: #eef1e4;
}

.page {
    height: 100vh;
    display: flex;
    flex-direction: column;
}

.view {
    flex: 1;
    overflow: hidden;
}

.trip-canvas {
    margin: 16rpx 16rpx 0;
    border-radius: 12rpx;
    box-shadow: 0 4rpx 18rpx rgba(16, 40, 36, 0.14);
}

.hint {
    padding: 16rpx 32rpx 24rpx;
    text-align: center;
    font-size: 22rpx;
    color: #7a8a84;
}

.actions {
    display: flex;
    padding: 16rpx 24rpx calc(20rpx + env(safe-area-inset-bottom));
    background: #f8faee;
    border-top: 2rpx solid rgba(31, 52, 48, 0.12);
}

.actions .btn {
    flex: 1;
    margin: 0 8rpx;
}

.loading {
    position: fixed;
    left: 50%;
    top: 45%;
    transform: translate(-50%, -50%);
    padding: 20rpx 40rpx;
    border-radius: 14rpx;
    background: rgba(21, 45, 42, 0.92);
    color: #f8faee;
    font-size: 26rpx;
}